# KENBEI — copy secrets locally to apps/web/.env.local. Never commit real values.

# PUBLIC (browser). Anon only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_APP_URL=https://app.kenbei.jp

# SERVER ONLY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Stripe. STANDARD 4–30 ¥39,800. BUSINESS 31–50 ¥65,000.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_BUSINESS=
# Optional aliases for STANDARD only
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Cron: Vercel sends Authorization: Bearer CRON_SECRET
CRON_SECRET=

# AI. Unset keys → heuristic fallback. Server only.
AI_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Japanese PDF. TTF/OTF only. Or place apps/web/fonts/NotoSansJP-Regular.ttf
PDF_FONT_PATH=

# Mobile (apps/mobile/.env) — public only
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
# EXPO_PUBLIC_APP_URL=https://app.kenbei.jp
