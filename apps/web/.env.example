# Copy to apps/web/.env.local — never commit real secrets.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_APP_URL=https://app.kenbei.jp

SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_BUSINESS=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=
CRON_SECRET=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
AI_PROVIDER=auto
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
KENBEI_AI_MODEL_LIGHT=
KENBEI_AI_MODEL_DEFAULT=
KENBEI_AI_MODEL_REASONING=
# Optional. AI HTTP timeout in ms (default 25000, min 3000, max 120000).
KENBEI_AI_TIMEOUT_MS=
# Optional. Default is fonts/NotoSansJP-Regular.ttf in this app.
PDF_FONT_PATH=
# Optional. Invite emails via Resend. Auth confirmation still uses Supabase SMTP.
RESEND_API_KEY=
RESEND_FROM=KENBEI <support@kenbei.jp>

# Web Push（ブラウザ・ホーム画面に追加したアプリへの通知）。未設定ならアプリ内のお知らせだけ動く。
# 作り方: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@kenbei.jp

# 運営画面 /ops を開ける人のメールアドレス（カンマ区切り）
PLATFORM_ADMIN_EMAILS=
